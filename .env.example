# Copy this file to .env and fill in the real values.
# GoDaddy/cPanel local relay defaults for this project.

SMTP_HOST=localhost
SMTP_PORT=25
SMTP_AUTH=false
SMTP_SECURE=none
SMTP_TIMEOUT=15

# Only needed when SMTP_AUTH=true.
SMTP_USER=no-reply@ace-mtech.ph
SMTP_PASS=

SMTP_FROM=no-reply@ace-mtech.ph
SMTP_FROM_NAME="Ace-mtech Website"
SMTP_TO=

# Optional app setting used elsewhere in the project.
APP_BASE_URL=
